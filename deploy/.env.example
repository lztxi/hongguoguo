# 复制为 .env 即可使用；fork 本仓库时把 lztxi 换成你的 GitHub 用户名（全小写）。
# 仓库 Settings → Actions → General → Workflow permissions 需允许 packages: write，
# 且镜像包可见性设为 Public，玩客云才能免登录拉取。
IMAGE=ghcr.io/lztxi/hongguoguo:latest

# 可选：指定某个带版本号的 tag 做灰度/回滚
# IMAGE=ghcr.io/lztxi/hongguoguo:v6.2-v1.7.1-a1b2c3d4

HEALTH=http://127.0.0.1:9636/api/health

# 空闲降级：无业务请求多少分钟后清空播放缓存并 full GC（默认 30 分钟）。
# Docker 健康检查与浏览器 SSE 心跳不计入「使用」，正在播放时绝不降级。
IDLE_SLEEP_MINUTES=30
# 设为 0 可完全禁用（回到旧行为）；改完执行 docker compose up -d 生效。
IDLE_SLEEP=1

# 连播预热：每集提前备好后续几集的分片计划，换集直接命中（默认 3 集）。
# 1 = 旧行为（只预热下一集），0 = 完全禁用预热。
HONGGUO_HGOP_WARM_DEPTH=3
# 播放计划存活分钟数（默认 10；上游只有 90s，一集没看完就过期会导致切集变慢）。
HONGGUO_HGOP_PLAN_TTL_MIN=10
